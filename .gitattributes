# Line endings are normalised in the repository and checked out native, so a
# clone on Windows does not produce whitespace churn on its first commit.
* text=auto

# PowerShell is only ever run on Windows here, so it keeps CRLF on checkout
# regardless of platform.
*.ps1 text eol=crlf

# Sources and notes stay LF, which is what every editor and every diff
# expects.
*.cpp  text eol=lf
*.comp text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.txt  text eol=lf

# Compiled shaders and captures are output, not source. Treating them as text
# would corrupt them.
*.spv binary
*.gfxr binary
*.png binary
