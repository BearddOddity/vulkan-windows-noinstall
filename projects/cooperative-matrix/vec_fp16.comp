#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// The packed half ceiling, same shape as vec_fp32.comp.
//
// f16vec2 rather than float16_t: the hardware instruction that matters is
// v_pk_fma_f16, which does two halves per lane. A scalar float16_t chain
// measures the same unit doing half the work.
//
// The seed buffer stays fp32 and is converted here, so the shader needs no
// 16-bit storage feature - only shaderFloat16 for the arithmetic.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer In  { float seed[]; };
layout(std430, binding = 1) writeonly buffer Out { float result[]; };

layout(push_constant) uniform Push { uint iters; } pc;

void main()
{
    float16_t s = float16_t(seed[gl_LocalInvocationID.x & 63u]);

    f16vec2 a0 = f16vec2(s, s + float16_t(1.0));
    f16vec2 a1 = f16vec2(s + float16_t(2.0), s + float16_t(3.0));
    f16vec2 a2 = f16vec2(s + float16_t(4.0), s + float16_t(5.0));
    f16vec2 a3 = f16vec2(s + float16_t(6.0), s + float16_t(7.0));
    f16vec2 a4 = f16vec2(s + float16_t(8.0), s + float16_t(9.0));
    f16vec2 a5 = f16vec2(s + float16_t(10.0), s + float16_t(11.0));
    f16vec2 a6 = f16vec2(s + float16_t(12.0), s + float16_t(13.0));
    f16vec2 a7 = f16vec2(s + float16_t(14.0), s + float16_t(15.0));

    // Half has five exponent bits. A multiplier further from one than this
    // walks the chain into infinity long before the loop ends.
    f16vec2 m = f16vec2(float16_t(1.0) + s * float16_t(1.0e-3));
    f16vec2 b = f16vec2(s * float16_t(1.0e-3));

    for (uint i = 0u; i < pc.iters; ++i) {
        a0 = fma(a0, m, b);
        a1 = fma(a1, m, b);
        a2 = fma(a2, m, b);
        a3 = fma(a3, m, b);
        a4 = fma(a4, m, b);
        a5 = fma(a5, m, b);
        a6 = fma(a6, m, b);
        a7 = fma(a7, m, b);
    }

    f16vec2 sum = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7;
    result[gl_GlobalInvocationID.x] = float(sum.x) + float(sum.y);
}
